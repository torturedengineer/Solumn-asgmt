+#!/bin/bash
+# DEV-ONLY control: pings go straight out with urllib, no limiter (the failure variant2 targets)
+set -euo pipefail
+python3 - <<'PYEOF'
+from pathlib import Path
+p = Path("/app/pulsewire/cli.py")
+src = p.read_text()
+old = '''def cmd_broadcast(message: str):
+    recipients = [s["email"] for s in subscribers.get_active_subscribers()]
+    result = gateway_client.send_batch(recipients, message)
+    print(f"Broadcast sent to {result['sent']} subscribers.")
+'''
+new = '''def cmd_broadcast(message: str):
+    import json, time, urllib.request
+    active = subscribers.get_active_subscribers()
+    recipients = [s["email"] for s in active]
+    result = gateway_client.send_batch(recipients, message)
+    for s in active:
+        if s.get("callback_url"):
+            req = urllib.request.Request(s['callback_url'], data=json.dumps({'recipient': s['email']}).encode(), headers={'Content-Type': 'application/json'}, method='POST')
+            urllib.request.urlopen(req, timeout=10).read()
+    print(f"Broadcast sent to {result['sent']} subscribers.")
+'''
+assert src.count(old) == 1
+p.write_text(src.replace(old, new))
+PYEOF
